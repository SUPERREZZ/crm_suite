# ==============================================================================
# SuiteCRM 8 B2B Demo Stack - Cloud & Local Environment Configuration Template
# ==============================================================================
# SALIN FILE INI MENJADI .env DAN SESUAIKAN NILAINYA
# JANGAN PERNAH MENYIMPAN / COMMIT FILE .env YANG ASLI KE GITHUB!
# ==============================================================================

# Pinned Container Images (Bitnami Legacy archive & Mailpit)
SUITECRM_IMAGE=bitnamilegacy/suitecrm:8.8.1-debian-12-r3
MARIADB_IMAGE=bitnamilegacy/mariadb:10.11.11-debian-12-r11
MAILPIT_IMAGE=axllent/mailpit:v1.33.0

# Restart Policy: "unless-stopped" untuk Server Cloud / VPS, "no" untuk demo lokal
RESTART_POLICY=unless-stopped

# Port Binding Configuration:
# - Untuk server dengan Reverse Proxy (Nginx/Caddy): gunakan 127.0.0.1:8080:8080
# - Untuk akses langsung via IP publik VPS: gunakan 8080:8080
SUITECRM_PORT_BINDING=127.0.0.1:8080:8080
MAILPIT_HTTP_BINDING=127.0.0.1:8025:8025
MAILPIT_SMTP_BINDING=127.0.0.1:1025:1025

# MariaDB Credentials (GANTI DENGAN PASSWORD KUAT DI CLOUD)
MARIADB_ROOT_PASSWORD=ganti_dengan_root_password_acak_anda
MARIADB_USER=suitecrm
MARIADB_PASSWORD=ganti_dengan_db_password_acak_anda
MARIADB_DATABASE=bitnami_suitecrm

# SuiteCRM Database Connection
SUITECRM_DATABASE_HOST=mariadb
SUITECRM_DATABASE_PORT_NUMBER=3306
SUITECRM_DATABASE_USER=suitecrm
SUITECRM_DATABASE_PASSWORD=ganti_dengan_db_password_acak_anda
SUITECRM_DATABASE_NAME=bitnami_suitecrm

# SuiteCRM Admin User
SUITECRM_USERNAME=admin
SUITECRM_PASSWORD=ganti_dengan_admin_password_kuat_2026
SUITECRM_EMAIL=admin@sumberkopi.id

# Hostname / Domain Publik
# PERHATIAN: Bitnami otomatis menyusun site_url = "http://${SUITECRM_HOST}:8080".
# Jika menggunakan reverse proxy HTTPS (port 443 tanpa :8080) atau domain khusus,
# sesuaikan SUITECRM_HOST (misal: crm.domainanda.com atau IP_PUBLIK_VPS).
SUITECRM_HOST=localhost

# Mailpit Internal Reference (Outbound Email Testing)
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025

